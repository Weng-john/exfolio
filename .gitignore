# ---- Personal data: never commit ------------------------------------
# Local data store written by the Node backend (holdings, cash, loans).
data/
# Backups and exports produced by the app.
backups/
exports/
*.backup.json
exfolio-backup-*.json
# Broker / exchange statements and CSV files to import.
imports/
statements/
*.csv
*.tsv
*.xlsx
*.xls
*.ods
*.pdf
*.ofx
*.qfx
*.qif
*.zip
*.7z
# Screenshots of statements.
*.png
*.jpg
*.jpeg
*.webp
*.heic
# Fictional fixtures used by tests are the only statements and spreadsheets allowed in.
!tests/fixtures/statements/
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.tsv
# Private notes.
private/
*.private.md

# ---- Secrets: never commit ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
service-account*.json
token*.json
# clasp links the repo to a personal Google account and Apps Script project.
.clasp.json
.clasprc.json
gas/config.local.js

# ---- Build output and tooling ---------------------------------------
dist/
# Copied from node_modules at build time (scripts/vendor-ocr.mjs).
public/vendor/
node_modules/
*.local
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.cache/
.venv/
.DS_Store
