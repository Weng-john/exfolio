{
  "name": "exfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Exposure-based portfolio management (NAV-denominated exposure, leverage, loans, allocation).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/vendor-ocr.mjs && vite build",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:privacy": "node scripts/check-privacy.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "quotes:snapshot": "tsx scripts/fetch-quotes.mts",
    "build:public": "tsc --noEmit && node scripts/vendor-ocr.mjs && VITE_EXFOLIO_EDITION=public vite build && tsx scripts/fetch-quotes.mts dist/quotes.json",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "predev": "node scripts/vendor-ocr.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
