# Copy to .env (git-ignored) to override local backend defaults.

# Where the Node backend keeps your data. Point it outside the repository
# folder to make an accidental commit impossible.
# EXFOLIO_DATA_DIR=/absolute/path/outside/the/repo

# PORT=8787
# HOST=127.0.0.1

# Extra host names the backend answers to, comma-separated. By default only
# localhost / 127.0.0.1, so a web page on another site cannot reach it.
# EXFOLIO_ALLOWED_HOSTS=exfolio.lan

# Turn off sign-in for single-user use on a private machine.
# EXFOLIO_AUTH=off

# Master key for encrypting stored exchange API keys (see docs/INTEGRATIONS.md).
# EXFOLIO_SECRET_KEY=
